# Copia este archivo a .env (o .env.local) y ajusta la URL.
# Backend local (dev): http://localhost:5196
# Producción: la URL publicada del PFR_API
VITE_API_URL=http://localhost:5196

# Prueba local de pagos con Stripe: activa los botones de la pantalla de precios. Solo tiene
# efecto con `npm run dev` y si VITE_API_URL NO es el backend de producción (ver Precios.tsx).
# VITE_ENABLE_CHECKOUT=true
